# Copy to .env.live, run chmod 600 .env.live, and fill the private values locally.
# Do not commit .env.live.

POLYBOT2OTHER_LIVE_TRADING_DB_PATH=data/live/single_fak_real.sqlite3
POLYBOT2OTHER_LIVE_TRADING_SETTINGS_PATH=data/live/live-settings.json
POLYBOT2OTHER_LIVE_CHAIN_ID=137

# Hard runtime kill switch. Set false to remove the live runner from this process.
POLYBOT2OTHER_LIVE_TRADING_RUNTIME_ENABLED=true

# Software-only live budget guard. This does not limit external wallet spending.
# Polymarket CLOB V2 uses collateral/pUSD for trading; the bot treats the numbers
# below as dollar-denominated software accounting limits.
POLYBOT2OTHER_LIVE_DEFAULT_INITIAL_BALANCE=20
POLYBOT2OTHER_LIVE_DEFAULT_STAKE_DOLLARS=2
POLYBOT2OTHER_LIVE_DEFAULT_MAX_DAILY_LOSS=6
POLYBOT2OTHER_LIVE_DEFAULT_MAX_TOTAL_DRAWDOWN=12
POLYBOT2OTHER_LIVE_DEFAULT_RETRY_COUNT=2
POLYBOT2OTHER_LIVE_DEFAULT_RETRY_DELAY_MS=250

# Private signing key for the Polymarket trading wallet.
POLYBOT2OTHER_LIVE_PRIVATE_KEY=

# 0=EOA, 1=proxy wallet, 2=Gnosis Safe, 3=deposit wallet.
# For new Polymarket API users, prefer 3 with the deposit wallet as funder.
POLYBOT2OTHER_LIVE_SIGNATURE_TYPE=

# Address that holds collateral/pUSD funds and allowances for trading.
# When signature type is 0, this must equal the private-key signer address.
POLYBOT2OTHER_LIVE_FUNDER_ADDRESS=

# Optional. If blank, the SDK derives API credentials from the private key.
POLYBOT2OTHER_LIVE_API_KEY=
POLYBOT2OTHER_LIVE_API_SECRET=
POLYBOT2OTHER_LIVE_API_PASSPHRASE=
