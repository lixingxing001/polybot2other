{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hengzhun:project:baseline-event-contracts:1.0.0-baseline.1",
  "title": "Explicit preregistered REPLAY baseline intent extension",
  "$comment": "Original event_contracts.schema.json is unchanged. Source SHA256 a25de998642ae3fb45606dc32f07513d08a69b38f4f5d8308310d5b59b5379bd",
  "$defs": {
    "BaselineOrderIntent": {
      "type": "object",
      "properties": {
        "record_type": {
          "const": "BaselineOrderIntent"
        },
        "schema_version": {
          "const": "1.0.0-baseline.1"
        },
        "intent_id": {
          "$ref": "#/$defs/Id"
        },
        "intent_key": {
          "$ref": "#/$defs/IntentKey"
        },
        "identity": {
          "$ref": "#/$defs/EconomicIdentity"
        },
        "market": {
          "$ref": "#/$defs/MarketIdentity"
        },
        "market_owner_wallet_id": {
          "$ref": "#/$defs/Id"
        },
        "singleflight_wallet_id": {
          "$ref": "#/$defs/Id"
        },
        "created_at": {
          "$ref": "#/$defs/EpochMillis"
        },
        "reserved_at": {
          "$ref": "#/$defs/EpochMillis"
        },
        "submitted_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpochMillis"
            },
            {
              "type": "null"
            }
          ]
        },
        "acknowledged_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpochMillis"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpochMillis"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "RESERVED",
            "SUBMITTING",
            "ACKNOWLEDGED",
            "UNKNOWN",
            "TERMINAL_NO_FILL",
            "TERMINAL_WITH_FILL",
            "ABORTED_BEFORE_SEND",
            "REJECTED_CONFIRMED"
          ]
        },
        "period_consumed": {
          "const": true
        },
        "send_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "venue": {
          "const": "PAPER_VENUE"
        },
        "order_action": {
          "const": "BUY"
        },
        "order_type": {
          "const": "FAK"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "asset_id": {
          "$ref": "#/$defs/Id"
        },
        "limit_price": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "quantity_shares": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "budget_all_in": {
          "type": "string",
          "pattern": "^5(?:\\.0+)?$"
        },
        "cost_quote": {
          "$ref": "#/$defs/CostQuote"
        },
        "calibration_status": {
          "const": "UNCALIBRATED"
        },
        "model_artifact_sha256": {
          "type": "null"
        },
        "contract_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "config_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "decision_frame_id": {
          "$ref": "#/$defs/Id"
        },
        "reservation_id": {
          "$ref": "#/$defs/Id"
        },
        "risk_before": {
          "$ref": "#/$defs/WalletRiskState"
        },
        "risk_after": {
          "$ref": "#/$defs/WalletRiskState"
        },
        "expected_arrival_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpochMillis"
            },
            {
              "type": "null"
            }
          ]
        },
        "venue_order_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_hashes": {
          "$ref": "#/$defs/HashList"
        },
        "baseline_registration_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "frozen_provenance_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "baseline_id": {
          "enum": [
            "B1_FROZEN_UNIFIED",
            "B2_PRIOR"
          ]
        }
      },
      "required": [
        "record_type",
        "schema_version",
        "intent_id",
        "intent_key",
        "identity",
        "market",
        "market_owner_wallet_id",
        "singleflight_wallet_id",
        "created_at",
        "reserved_at",
        "submitted_at",
        "acknowledged_at",
        "terminal_at",
        "state",
        "period_consumed",
        "send_attempts",
        "venue",
        "order_action",
        "order_type",
        "side",
        "asset_id",
        "limit_price",
        "quantity_shares",
        "budget_all_in",
        "cost_quote",
        "calibration_status",
        "model_artifact_sha256",
        "contract_sha256",
        "config_sha256",
        "decision_frame_id",
        "reservation_id",
        "risk_before",
        "risk_after",
        "expected_arrival_at",
        "venue_order_id",
        "terminal_reason",
        "evidence_hashes",
        "baseline_registration_sha256",
        "frozen_provenance_sha256",
        "baseline_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "identity": {
              "properties": {
                "economic_space": {
                  "properties": {
                    "mode": {
                      "enum": [
                        "REPLAY",
                        "PAPER"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "calibration_status": {
                "const": "CALIBRATED"
              }
            },
            "required": [
              "calibration_status"
            ]
          },
          "then": {
            "properties": {
              "model_artifact_sha256": {
                "$ref": "#/$defs/Sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "calibration_status": {
                "const": "UNCALIBRATED"
              }
            },
            "required": [
              "calibration_status"
            ]
          },
          "then": {
            "properties": {
              "model_artifact_sha256": {
                "type": "null"
              },
              "identity": {
                "properties": {
                  "economic_space": {
                    "properties": {
                      "ledger_scope": {
                        "const": "PAPER_PORTFOLIO"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "SUBMITTING",
                  "ACKNOWLEDGED",
                  "UNKNOWN",
                  "TERMINAL_NO_FILL",
                  "TERMINAL_WITH_FILL",
                  "REJECTED_CONFIRMED"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "send_attempts": {
                "const": 1
              },
              "submitted_at": {
                "$ref": "#/$defs/EpochMillis"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "TERMINAL_NO_FILL",
                  "TERMINAL_WITH_FILL",
                  "ABORTED_BEFORE_SEND",
                  "REJECTED_CONFIRMED"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "terminal_at": {
                "$ref": "#/$defs/EpochMillis"
              },
              "terminal_reason": {
                "$ref": "#/$defs/Id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "ABORTED_BEFORE_SEND"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "send_attempts": {
                "const": 0
              },
              "submitted_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "properties": {
            "identity": {
              "properties": {
                "economic_space": {
                  "properties": {
                    "mode": {
                      "const": "REPLAY"
                    },
                    "ledger_scope": {
                      "const": "PAPER_PORTFOLIO"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Project extension for explicitly preregistered B1/B2 funded REPLAY controls. Never a calibrated Hengzhun prediction or a PAPER mode bypass."
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "内部或适配器保留的原始标识；本合同不假定官方标识格式。"
    },
    "EpochMillis": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "UTC Unix epoch 毫秒；不接受秒单位、字符串时间或浮点毫秒。"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "64 位小写十六进制 SHA256，不带 0x；内容和规范化算法由应用核验。"
    },
    "HashList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Sha256"
      },
      "uniqueItems": true
    },
    "WalletRiskState": {
      "type": "object",
      "properties": {
        "scope": {
          "const": "WALLET_GLOBAL_WITHIN_ECONOMIC_SPACE"
        },
        "open_risk_slot_limit": {
          "const": 1
        },
        "open_risk_slots_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "cash_confirmed": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "cash_reserved": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "position_cost_unresolved": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "claim_receivable": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "claim_cost_committed": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "committed_cost_total": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "rolling_24h_gross_loss": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "unresolved_max_loss": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "realized_pnl": {
          "$ref": "#/$defs/Decimal"
        },
        "claim_pending_markets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "claim_reserved_markets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "claim_slot_limit": {
          "const": 2
        },
        "unknown_exposure": {
          "type": "boolean"
        },
        "valuation_status": {
          "enum": [
            "VERIFIED",
            "UNCERTAIN"
          ]
        },
        "drawdown_halt": {
          "type": "boolean"
        },
        "snapshot_at": {
          "$ref": "#/$defs/EpochMillis"
        }
      },
      "required": [
        "scope",
        "open_risk_slot_limit",
        "open_risk_slots_used",
        "cash_confirmed",
        "cash_reserved",
        "position_cost_unresolved",
        "claim_receivable",
        "claim_cost_committed",
        "committed_cost_total",
        "rolling_24h_gross_loss",
        "unresolved_max_loss",
        "realized_pnl",
        "claim_pending_markets",
        "claim_reserved_markets",
        "claim_slot_limit",
        "unknown_exposure",
        "valuation_status",
        "drawdown_halt",
        "snapshot_at"
      ],
      "additionalProperties": false,
      "description": "同空间同钱包跨策略共享单风险槽。字段是经过聚合的账本快照；去重、claim 两类占用之和、成本不可重复计提、风险公式与额度由数据库事务验证。"
    },
    "Decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 80,
      "description": "普通十进制字符串，禁止指数记法、千分位、NaN 与 Infinity。使用 Decimal/BigDecimal 运算。"
    },
    "NonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 80
    },
    "CostQuote": {
      "type": "object",
      "properties": {
        "fee_model_id": {
          "$ref": "#/$defs/Id"
        },
        "fee_collection_mode": {
          "enum": [
            "CASH_ADDED",
            "SHARES_DEDUCTED",
            "NONE"
          ]
        },
        "gross_shares": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "net_shares": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "cash_before_fees": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "fee_cash": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "fee_shares": {
          "$ref": "#/$defs/NonNegativeDecimal"
        },
        "all_in_cash": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "all_in_cost_per_net_share": {
          "$ref": "#/$defs/PositiveDecimal"
        },
        "levels_used": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "price": {
                "$ref": "#/$defs/PositiveDecimal"
              },
              "gross_shares": {
                "$ref": "#/$defs/PositiveDecimal"
              },
              "fee_cash": {
                "$ref": "#/$defs/NonNegativeDecimal"
              },
              "fee_shares": {
                "$ref": "#/$defs/NonNegativeDecimal"
              }
            },
            "required": [
              "price",
              "gross_shares",
              "fee_cash",
              "fee_shares"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "rounding_rule_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "fee_model_id",
        "fee_collection_mode",
        "gross_shares",
        "net_shares",
        "cash_before_fees",
        "fee_cash",
        "fee_shares",
        "all_in_cash",
        "all_in_cost_per_net_share",
        "levels_used",
        "rounding_rule_id"
      ],
      "additionalProperties": false,
      "description": "两种收费方式统一输出总付现金和净到账份额。现金费与扣份额不得重复计入；求和、预算和逐档精度由应用核验。"
    },
    "PositiveDecimal": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$",
      "maxLength": 80
    },
    "Side": {
      "enum": [
        "UP",
        "DOWN"
      ]
    },
    "MarketIdentity": {
      "type": "object",
      "properties": {
        "market_uid": {
          "$ref": "#/$defs/Id"
        },
        "condition_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "market_uid",
        "condition_id"
      ],
      "additionalProperties": false
    },
    "EconomicIdentity": {
      "type": "object",
      "properties": {
        "economic_space": {
          "$ref": "#/$defs/EconomicSpace"
        },
        "wallet_id": {
          "$ref": "#/$defs/Id"
        },
        "strategy_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "economic_space",
        "wallet_id",
        "strategy_id"
      ],
      "additionalProperties": false
    },
    "EconomicSpace": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "RECORD",
            "REPLAY",
            "PAPER"
          ]
        },
        "portfolio_run_id": {
          "$ref": "#/$defs/Id"
        },
        "scenario_id": {
          "$ref": "#/$defs/Id"
        },
        "ledger_scope": {
          "enum": [
            "SIGNAL_SHADOW",
            "PAPER_PORTFOLIO"
          ]
        }
      },
      "required": [
        "mode",
        "portfolio_run_id",
        "scenario_id",
        "ledger_scope"
      ],
      "additionalProperties": false,
      "description": "经济空间四元组。整个组合内共用此空间，钱包级限制跨策略生效；不同场景的资金与收益不得合并。SHADOW_PRIOR 是通道标签，不是 mode。"
    },
    "IntentKey": {
      "type": "object",
      "properties": {
        "wallet_id": {
          "$ref": "#/$defs/Id"
        },
        "strategy_id": {
          "$ref": "#/$defs/Id"
        },
        "condition_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "wallet_id",
        "strategy_id",
        "condition_id"
      ],
      "additionalProperties": false,
      "description": "数据库唯一约束还须前置经济空间四元组。刻意不含方向、模型和配置版本。"
    }
  },
  "$ref": "#/$defs/BaselineOrderIntent"
}
