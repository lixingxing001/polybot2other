{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hengzhun:v1:config",
  "title": "衡准 V1 内部配置合同",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime",
    "market",
    "data",
    "prior",
    "calibration",
    "entry",
    "risk",
    "paper",
    "research"
  ],
  "properties": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "live_execution_enabled",
        "strategy_id",
        "spec_version",
        "display_timezone",
        "decision_interval_ms",
        "seed"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1,
          "description": "运行模式，仅 RECORD、REPLAY、PAPER。",
          "default": "RECORD",
          "enum": [
            "RECORD",
            "REPLAY",
            "PAPER"
          ]
        },
        "live_execution_enabled": {
          "type": "boolean",
          "description": "硬禁用真实执行，配置 schema 只接受 false。",
          "default": false,
          "const": false
        },
        "strategy_id": {
          "type": "string",
          "minLength": 1,
          "description": "固定策略身份，不随模型更新改名绕过资格。",
          "default": "HENGZHUN_TWAP_VALUE_V1",
          "const": "HENGZHUN_TWAP_VALUE_V1"
        },
        "spec_version": {
          "type": "string",
          "minLength": 1,
          "description": "设计规范版本。",
          "default": "1.0.0",
          "const": "1.0.0"
        },
        "display_timezone": {
          "type": "string",
          "minLength": 1,
          "description": "展示时区，内部统一 UTC。",
          "default": "Asia/Shanghai"
        },
        "decision_interval_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "最长每 250 毫秒评估一次变化后的输入。",
          "default": 250
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "description": "固定研究随机种子。",
          "default": 20261106
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "duration_seconds",
        "twap_window_seconds",
        "require_verified_contract",
        "external_direction_filter"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1,
          "description": "只评价 BTC。",
          "default": "BTC",
          "const": "BTC"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "真实合约窗口长度。",
          "default": 300,
          "const": 300
        },
        "twap_window_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "只支持已核验六十秒 TWAP 规则。",
          "default": 60,
          "const": 60
        },
        "require_verified_contract": {
          "type": "boolean",
          "description": "基准、规则、协议和费用未知时禁止新增风险。",
          "default": true,
          "const": true
        },
        "external_direction_filter": {
          "type": "string",
          "minLength": 1,
          "description": "外部交易所只作诊断，第一版不作为投票过滤。",
          "default": "DIAGNOSTIC_ONLY",
          "const": "DIAGNOSTIC_ONLY"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price_source_max_age_ms",
        "price_receive_max_age_ms",
        "book_source_max_age_ms",
        "book_receive_max_age_ms",
        "cross_book_max_skew_ms",
        "clock_offset_max_ms",
        "integral_max_gap_ms",
        "recovery_healthy_seconds"
      ],
      "properties": {
        "price_source_max_age_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "spot 与官方 TWAP 最大源年龄。",
          "default": 1500
        },
        "price_receive_max_age_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "spot 与官方 TWAP 最大接收年龄。",
          "default": 1000
        },
        "book_source_max_age_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "完整盘口最大源年龄。",
          "default": 1000
        },
        "book_receive_max_age_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "完整盘口最大接收年龄。",
          "default": 1000
        },
        "cross_book_max_skew_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Up 与 Down 盘口源时间差上限。",
          "default": 500
        },
        "clock_offset_max_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "时钟偏移上界超限暂停新增。",
          "default": 250
        },
        "integral_max_gap_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "前值保持积分允许的最大缺口。",
          "default": 2000
        },
        "recovery_healthy_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "重新同步并对账后连续健康时间。",
          "default": 10
        }
      }
    },
    "prior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vol_grid_seconds",
        "vol_fast_window_seconds",
        "vol_slow_window_seconds",
        "vol_fast_min_returns",
        "vol_slow_min_returns",
        "sigma_floor_bps_sqrt_second",
        "proxy_history_seconds",
        "proxy_sample_spacing_seconds",
        "proxy_min_samples",
        "proxy_sd_floor_bps",
        "proxy_abs_error_p95_max_bps",
        "shock_min_abs_return_bps",
        "shock_z_threshold",
        "shock_cooldown_seconds",
        "numeric_probability_clip"
      ],
      "properties": {
        "vol_grid_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "UTC 采样网格。",
          "default": 5
        },
        "vol_fast_window_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "快窗实现方差。",
          "default": 120
        },
        "vol_slow_window_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "慢窗实现方差。",
          "default": 600
        },
        "vol_fast_min_returns": {
          "type": "integer",
          "minimum": 0,
          "description": "快窗最少有效五秒收益。",
          "default": 20
        },
        "vol_slow_min_returns": {
          "type": "integer",
          "minimum": 0,
          "description": "慢窗最少有效五秒收益。",
          "default": 96
        },
        "sigma_floor_bps_sqrt_second": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "每根号秒 bps 标准差下限，仅研究初值。",
          "default": "0.25"
        },
        "proxy_history_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "代理误差历史窗口二十四小时。",
          "default": 86400
        },
        "proxy_sample_spacing_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "代理对照记录最小间隔。",
          "default": 60
        },
        "proxy_min_samples": {
          "type": "integer",
          "minimum": 0,
          "description": "正常代理误差估计所需记录数。",
          "default": 120
        },
        "proxy_sd_floor_bps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "代理误差标准差下限。",
          "default": "1.0"
        },
        "proxy_abs_error_p95_max_bps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "重建偏差超限拒绝已校准账户。",
          "default": "3.0"
        },
        "shock_min_abs_return_bps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "冲击识别绝对幅度门槛。",
          "default": "10.0"
        },
        "shock_z_threshold": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "相对冲击前慢窗标准差的倍数。",
          "default": "6.0"
        },
        "shock_cooldown_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "已发生冲击后的新增冷却。",
          "default": 60
        },
        "numeric_probability_clip": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "CDF 数值保护，不代表经济上的概率上下界。",
          "default": "0.000000000001"
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landmarks_seconds",
        "landmark_max_lateness_ms",
        "train_window_days",
        "validation_window_days",
        "test_window_days",
        "min_train_markets",
        "min_train_days",
        "min_markets_each_outcome",
        "min_validation_markets",
        "logit_clip",
        "standardization_scale_floor",
        "ridge_lambda",
        "optimizer_max_iterations",
        "optimizer_tolerance",
        "bootstrap_models",
        "bootstrap_min_success",
        "guard_quantiles",
        "model_error_buffer",
        "max_abs_feature_z",
        "max_age_days",
        "validation_score_tolerance"
      ],
      "properties": {
        "landmarks_seconds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 5,
          "maxItems": 5,
          "description": "每期采样时点。",
          "default": [
            90,
            75,
            60,
            45,
            30
          ]
        },
        "landmark_max_lateness_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "landmark 允许的最大迟到。",
          "default": 1000
        },
        "train_window_days": {
          "type": "integer",
          "minimum": 0,
          "description": "外层时间训练窗口。",
          "default": 28
        },
        "validation_window_days": {
          "type": "integer",
          "minimum": 0,
          "description": "后移验证窗口。",
          "default": 7
        },
        "test_window_days": {
          "type": "integer",
          "minimum": 0,
          "description": "不重叠样本外测试窗口。",
          "default": 7
        },
        "min_train_markets": {
          "type": "integer",
          "minimum": 0,
          "description": "最低独立训练市场数。",
          "default": 3000
        },
        "min_train_days": {
          "type": "integer",
          "minimum": 0,
          "description": "最低有效 UTC 日数。",
          "default": 20
        },
        "min_markets_each_outcome": {
          "type": "integer",
          "minimum": 0,
          "description": "Up 与 Down 各自最低市场数。",
          "default": 300
        },
        "min_validation_markets": {
          "type": "integer",
          "minimum": 0,
          "description": "验证集最低独立市场数。",
          "default": 1000
        },
        "logit_clip": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "计算 logit 前的数值截断。",
          "default": "0.0001"
        },
        "standardization_scale_floor": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "标准差小于此值时替换为一并标记退化。",
          "default": "0.000000000001"
        },
        "ridge_lambda": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "归一化平均 log loss 的正则系数。",
          "default": "0.01"
        },
        "optimizer_max_iterations": {
          "type": "integer",
          "minimum": 0,
          "description": "离线拟合迭代上限。",
          "default": 1000
        },
        "optimizer_tolerance": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "离线拟合收敛容差。",
          "default": "0.00000001"
        },
        "bootstrap_models": {
          "type": "integer",
          "minimum": 0,
          "description": "按完整 UTC 日重采样拟合。",
          "default": 100
        },
        "bootstrap_min_success": {
          "type": "integer",
          "minimum": 0,
          "description": "不足时拒绝发布。",
          "default": 90
        },
        "guard_quantiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "description": "非负十进制字符串，不允许二进制浮点替代资金精度。"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "线性插值分位数，属于敏感度区间。",
          "default": [
            "0.10",
            "0.90"
          ]
        },
        "model_error_buffer": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "额外保守概率缓冲。",
          "default": "0.02"
        },
        "max_abs_feature_z": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "训练变换后的绝对特征范围。",
          "default": "5.0"
        },
        "max_age_days": {
          "type": "integer",
          "minimum": 0,
          "description": "模型发布有效期。",
          "default": 7
        },
        "validation_score_tolerance": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "相对盘口 Brier 与 log loss 的绝对粗略容差。",
          "default": "0.01"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submit_remaining_min_seconds",
        "submit_remaining_max_seconds",
        "expected_arrival_remaining_min_seconds",
        "minimum_best_ask",
        "hard_limit_price_cap",
        "max_spread",
        "max_slippage_ticks",
        "minimum_guard_edge",
        "minimum_guard_roi",
        "budget_usd",
        "max_intents_per_market",
        "value_tie_tolerance_usd"
      ],
      "properties": {
        "submit_remaining_min_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "提交时剩余时间下限，包含边界。",
          "default": 30
        },
        "submit_remaining_max_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "提交时剩余时间上限，包含边界。",
          "default": 90
        },
        "expected_arrival_remaining_min_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "发送前按已知延迟验证的预计到达下限。",
          "default": 25
        },
        "minimum_best_ask": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "所买方向最低卖一。",
          "default": "0.20"
        },
        "hard_limit_price_cap": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "最高下单价，仍须满足费用后的价值门槛。",
          "default": "0.70"
        },
        "max_spread": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "所买方向的绝对买卖价差。",
          "default": "0.02"
        },
        "max_slippage_ticks": {
          "type": "integer",
          "minimum": 0,
          "description": "相对最新卖一最多增加一个当前 tick。",
          "default": 1
        },
        "minimum_guard_edge": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "guard 减最坏含费成本的下限。",
          "default": "0.03"
        },
        "minimum_guard_roi": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "guard 除最坏成本再减一的下限。",
          "default": "0.05"
        },
        "budget_usd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "固定含费预算上限；资金不足时拒绝，不临时缩单。",
          "default": "5.00"
        },
        "max_intents_per_market": {
          "type": "integer",
          "minimum": 0,
          "description": "包括后续零成交或发送前中止的已创建意图。",
          "default": 1,
          "const": 1
        },
        "value_tie_tolerance_usd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "两侧保守期望差在此范围内拒绝。",
          "default": "0.000000001"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_paper_cash_usd",
        "max_open_risk_positions",
        "max_committed_cost_usd",
        "max_claim_pending_markets",
        "gross_loss_24h_plus_risk_cap_usd",
        "maximum_high_water_drawdown",
        "wallet_single_flight",
        "wallet_market_single_owner"
      ],
      "properties": {
        "initial_paper_cash_usd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "每条独立账户轨迹初始模拟现金。",
          "default": "100.00"
        },
        "max_open_risk_positions": {
          "type": "integer",
          "minimum": 0,
          "description": "同经济空间整个共享钱包的预占、未知与未确定结算市场合计最多一笔。",
          "default": 1
        },
        "max_committed_cost_usd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "剩余预占、未结算成本和待领取成本合计上限。",
          "default": "10.00"
        },
        "max_claim_pending_markets": {
          "type": "integer",
          "minimum": 0,
          "description": "钱包待领取市场加已预留且可能产生正支付的市场合计上限，原子预留名额。",
          "default": 2
        },
        "gross_loss_24h_plus_risk_cap_usd": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "G24 加未决风险和下一笔预算的上限。",
          "default": "10.00"
        },
        "maximum_high_water_drawdown": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "有效净值高水位回撤达到此值锁定新增。",
          "default": "0.15"
        },
        "wallet_single_flight": {
          "type": "boolean",
          "description": "同钱包跨策略单飞和原子预占。",
          "default": true,
          "const": true
        },
        "wallet_market_single_owner": {
          "type": "boolean",
          "description": "共享钱包同一期只允许一个风险拥有者。",
          "default": true,
          "const": true
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_evidence",
        "default_scenario",
        "total_delay_ms",
        "depth_haircut",
        "confirm_after_fill_ms",
        "claim_after_final_ms",
        "book_model",
        "require_post_submit_book",
        "scenarios"
      ],
      "properties": {
        "execution_evidence": {
          "type": "string",
          "minLength": 1,
          "description": "默认未校准情景，不能宣称真实执行收益。",
          "default": "ASSUMED",
          "enum": [
            "ASSUMED",
            "EMPIRICAL"
          ]
        },
        "default_scenario": {
          "type": "string",
          "minLength": 1,
          "description": "完整报告 S1 S2 S3。",
          "default": "S1",
          "enum": [
            "S1",
            "S2",
            "S3"
          ]
        },
        "total_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "S1 全链路总到达延迟。",
          "default": 1000
        },
        "depth_haircut": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "description": "S1 可见盘口深度比例。",
          "default": "0.50"
        },
        "confirm_after_fill_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "从撮合起计的确认延迟假设。",
          "default": 12000
        },
        "claim_after_final_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "从已核实最终结果及持仓起计的领取延迟假设。",
          "default": 60000
        },
        "book_model": {
          "type": "string",
          "minLength": 1,
