{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hengzhun:project:input-provenance:1.0.0",
  "type": "object",
  "properties": {
    "record_type": {
      "const": "InputProvenanceManifest"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "previous_manifest_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence_range": {
      "type": "object",
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 1
        },
        "last": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "first",
        "last"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "item_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "cumulative_visible_events": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_received_at": {
      "type": "integer",
      "minimum": 0
    },
    "time_eligibility_is_not_model_inclusion": {
      "const": true
    },
    "derived": {
      "const": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "item": {
      "type": "object",
      "properties": {
        "ingest_seq": {
          "type": "integer",
          "minimum": 1
        },
        "payload_sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "source_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at": {
          "type": "integer",
          "minimum": 0
        },
        "source_time_status": {
          "enum": [
            "VALID",
            "MISSING",
            "FUTURE",
            "MALFORMED"
          ]
        },
        "model_time_eligible": {
          "type": "boolean"
        },
        "audit_only_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "ingest_seq",
        "payload_sha256",
        "source_kind",
        "source_id",
        "stream_id",
        "source_at",
        "received_at",
        "source_time_status",
        "model_time_eligible",
        "audit_only_reason"
      ]
    }
  },
  "required": [
    "record_type",
    "schema_version",
    "previous_manifest_sha256",
    "sequence_range",
    "items",
    "item_count",
    "cumulative_visible_events",
    "maximum_received_at",
    "time_eligibility_is_not_model_inclusion",
    "derived"
  ]
}
